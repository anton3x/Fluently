    "@types/react": "~19.2.15",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
